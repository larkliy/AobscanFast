<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PlatformTarget>x64</PlatformTarget>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>AobscanFast</PackageId>
		<Version>2.0.0</Version>
		<Authors>larkliy</Authors>
		<Description>High-performance memory pattern (AOB) scanner for Windows and Linux.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/larkliy/AobscanFast</RepositoryUrl>
		<PackageTags>memory;scan;aob;pattern;simd</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.269">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="AobscanFast.Tests" />
	</ItemGroup>

	<!-- ALERT!!!! Build a library before starting project compilation!!!-->
	<ItemGroup>
		<None Include="..\AobscanFast.NativeC\runtimes\**\*\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<Pack>true</Pack>
			<PackagePath>runtimes\%(RecursiveDir)</PackagePath>
		</None>

		<None Include="..\AobscanFast.NativeC\build\Release\AobscanFastNativeC.dll" Condition="Exists('..\AobscanFast.NativeC\build\Release\AobscanFastNativeC.dll')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>AobscanFastNativeC.dll</Link>
		</None>
		<None Include="..\AobscanFast.NativeC\runtimes\win-x64\native\Release\AobscanFastNativeC.dll" Condition="Exists('..\AobscanFast.NativeC\runtimes\win-x64\native\Release\AobscanFastNativeC.dll')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>AobscanFastNativeC.dll</Link>
		</None>
	</ItemGroup>

</Project>